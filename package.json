{
  "name": "@byte-42/cueflow",
  "version": "0.1.46",
  "description": "Build narrated, animated UI walkthroughs from static HTML scenes, driven by an MCP server",
  "keywords": [
    "tutorial",
    "walkthrough",
    "narration",
    "ui",
    "documentation",
    "mcp",
    "studio"
  ],
  "homepage": "https://github.com/Byte42-it/cueflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byte42-it/cueflow.git"
  },
  "bugs": {
    "url": "https://github.com/Byte42-it/cueflow/issues"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cueflow": "build/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "rm -rf build && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepack": "npm run build",
    "build:demo": "node src/cli.ts build upload --kit examples/demo-kit",
    "mcp": "node src/cli.ts mcp",
    "studio": "node src/cli.ts studio"
  },
  "dependencies": {
    "@byte-42/fantastico-sdk": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ffmpeg-static": "^5.3.0",
    "linkedom": "^0.18.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "playwright": ">=1.45"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.50.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "build",
    "examples/demo-kit",
    "!examples/demo-kit/dist",
    "!examples/demo-kit/audio",
    "examples/themes",
    "assets/brand",
    "README.md",
    "LICENSE"
  ]
}
