{
  "base": "http://localhost:4399",
  "lang": "en",
  "scenes": [
    {
      "name": "studio-ai",
      "url": "/",
      "steps": [
        {
          "waitFor": "#film"
        },
        {
          "click": "#ai"
        },
        {
          "wait": 800
        }
      ],
      "script": "capture/inline-frames.js",
      "hide": [
        "#dlg"
      ]
    },
    {
      "name": "studio-timeline",
      "url": "/",
      "steps": [
        {
          "wait": 1200
        }
      ],
      "script": "capture/inline-frames.js"
    },
    {
      "name": "studio-media",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "[data-page=media]"
        },
        {
          "wait": 1000
        }
      ],
      "script": "capture/inline-frames.js"
    },
    {
      "name": "studio-voice",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "[data-page=voice]"
        },
        {
          "wait": 1000
        }
      ],
      "script": "capture/inline-frames.js"
    },
    {
      "name": "studio-export",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "[data-page=export]"
        },
        {
          "wait": 1000
        }
      ],
      "script": "capture/inline-frames.js"
    },
    {
      "name": "studio-write",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "text=Written part"
        },
        {
          "wait": 1500
        }
      ],
      "script": "capture/inline-frames.js"
    },
    {
      "name": "studio-preview",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "[data-page=preview]"
        },
        {
          "wait": 1500
        },
        {
          "wait": 1000
        }
      ],
      "script": "capture/inline-frames.js"
    },
    {
      "name": "studio-details",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "text=Written part"
        },
        {
          "wait": 1200
        },
        {
          "click": "[data-docpage=details]"
        },
        {
          "wait": 1000
        }
      ],
      "script": "capture/inline-frames.js"
    },
    {
      "name": "studio-doc-preview",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "text=Written part"
        },
        {
          "wait": 1200
        },
        {
          "click": "[data-docpage=preview]"
        },
        {
          "wait": 1500
        },
        {
          "wait": 1000
        }
      ],
      "script": "capture/inline-frames.js"
    },
    {
      "name": "studio-dashboard",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "#dashboard"
        },
        {
          "wait": 1200
        },
        {
          "wait": 1000
        }
      ],
      "script": "capture/inline-frames.js",
      "hide": [
        "#dlg"
      ],
      "cues": {
        "dash-category": "#dlg input >> nth=1"
      }
    },
    {
      "name": "studio-project",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "#project"
        },
        {
          "wait": 1000
        }
      ],
      "script": "capture/inline-frames.js",
      "hide": [
        "#dlg"
      ],
      "cues": {
        "voice-browser": "#dlg .lvl label:has-text(\"Browser voice\")",
        "brief-who": "#dlg > div > .fields label >> nth=0 >> input",
        "brief-rules": "#dlg > div > .fields textarea >> nth=0"
      }
    },
    {
      "name": "studio-check",
      "script": "capture/inline-frames.js",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "[data-page=export]"
        },
        {
          "wait": 800
        },
        {
          "click": "text=Check this video"
        },
        {
          "wait": 2500
        }
      ],
      "cues": {
        "result": "#export-body > div > .result"
      },
      "hide": [
        "#export-body > div > .result"
      ]
    },
    {
      "name": "studio-built-video",
      "script": "capture/inline-frames.js",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "[data-page=export]"
        },
        {
          "wait": 800
        },
        {
          "click": "text=Build this video"
        },
        {
          "waitFor": "text=Open it"
        },
        {
          "wait": 800
        }
      ],
      "cues": {
        "result": "#export-body > div > .result"
      },
      "hide": [
        "#export-body > div > .result"
      ]
    },
    {
      "name": "studio-built",
      "script": "capture/inline-frames.js",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "[data-page=export]"
        },
        {
          "wait": 800
        },
        {
          "click": "text=Build the whole site"
        },
        {
          "waitFor": "text=Open it"
        },
        {
          "wait": 800
        }
      ],
      "cues": {
        "result": "#export-body > div > .result",
        "built-msg": "#export-body .msg.ok:has-text(\"Built\")"
      },
      "hide": [
        "#export-body > div > .result"
      ]
    },
    {
      "name": "studio-actions",
      "script": "capture/inline-frames.js",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "#page-timeline button:has-text(\"Actions\")"
        },
        {
          "wait": 1000
        }
      ],
      "cues": {
        "act-at": ".act >> nth=0 >> input >> nth=1"
      }
    },
    {
      "name": "studio-buildall",
      "script": "capture/inline-frames.js",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "#exportall"
        },
        {
          "wait": 800
        },
        {
          "click": "#dlg .btn.primary"
        },
        {
          "waitFor": "text=Open the dashboard"
        },
        {
          "wait": 800
        }
      ],
      "cues": {
        "all-result": "#dlg .result",
        "all-go": "#dlg .btn.primary"
      },
      "hide": [
        "#dlg",
        "#dlg .result"
      ]
    },
    {
      "name": "studio-speech",
      "url": "/",
      "steps": [
        {
          "wait": 800
        },
        {
          "click": "#page-timeline .tabs button:has-text(\"Voice\")"
        },
        {
          "wait": 1000
        }
      ],
      "script": "capture/inline-frames.js"
    },
    {
      "name": "site-home",
      "url": "/out/site/index.html",
      "steps": [
        {
          "wait": 1200
        }
      ]
    }
  ],
  "replace": [
    {
      "text": "${STUDIO_PROJECT}",
      "with": "/home/you/my-project"
    },
    {
      "text": "${STUDIO_KEY}",
      "with": "YOUR-SESSION-KEY"
    },
    {
      "text": "localhost:4399",
      "with": "localhost:4310"
    }
  ]
}
