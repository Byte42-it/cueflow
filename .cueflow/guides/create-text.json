{
  "id": "create-text",
  "title": "Create a written guide",
  "scene": "studio-write",
  "vertical": false,
  "format": "video",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "stage": {
    "width": 640,
    "height": 360
  },
  "languages": [
    "en",
    "it"
  ],
  "player": {
    "captions": "below",
    "chapters": true,
    "speeds": [
      1,
      1.5
    ],
    "transcript": true,
    "brand": "stage",
    "fallbackVoice": "none"
  },
  "pronunciation": {},
  "steps": [
    {
      "id": "pick",
      "title": {
        "en": "A guide next to the video",
        "it": "Una guida accanto al video"
      },
      "scene": "studio-write",
      "camera": {
        "target": "#film",
        "padding": 16
      },
      "actions": [
        {
          "do": "hide",
          "to": "#doc-write",
          "at": 0,
          "effect": "none",
          "duration": 0,
          "stagger": 0
        },
        {
          "do": "move",
          "to": ".tile.on",
          "at": "14%",
          "duration": 800
        },
        {
          "do": "click",
          "to": ".tile.on",
          "at": "42%"
        },
        {
          "do": "show",
          "to": "#doc-write",
          "at": "44%",
          "effect": "fade",
          "duration": 420
        },
        {
          "do": "camera",
          "at": "48%",
          "target": {
            "x": 0,
            "y": 0,
            "width": 1280,
            "height": 720
          },
          "padding": 0,
          "duration": 1100,
          "easing": "ease-in-out"
        }
      ],
      "narration": {
        "en": "A written guide is a page of text that sits next to your videos. In the list, it is marked as a written part.",
        "it": "Una guida scritta è una pagina di testo che sta accanto ai video. Nell'elenco è segnata come parte scritta."
      },
      "hold": 600
    },
    {
      "id": "sections",
      "title": {
        "en": "Sections",
        "it": "Sezioni"
      },
      "scene": "studio-write",
      "camera": {
        "target": "#doc-outline",
        "padding": 40
      },
      "actions": [
        {
          "do": "hide",
          "to": "#doc-outline .osec + .osec",
          "at": 0,
          "effect": "none",
          "duration": 0,
          "stagger": 0
        },
        {
          "do": "move",
          "to": "#doc-outline .side-actions .btn:first-child",
          "at": "16%",
          "duration": 800
        },
        {
          "do": "click",
          "to": "#doc-outline .side-actions .btn:first-child",
          "at": "42%"
        },
        {
          "do": "show",
          "to": "#doc-outline .osec + .osec",
          "at": "44%",
          "effect": "slide-up",
          "duration": 320
        },
        {
          "do": "highlight",
          "to": "#doc-outline .osec + .osec",
          "at": "50%",
          "duration": 1300
        }
      ],
      "narration": {
        "en": "On the left are the sections. Add one with + Section, and drag them to change the order.",
        "it": "A sinistra ci sono le sezioni. Aggiungine una con + Section e trascinale per cambiare l'ordine."
      },
      "speech": {
        "en": "On the left are the sections. Add one with plus Section, and drag them to change the order.",
        "it": "A sinistra ci sono le sezioni. Aggiungine una con più Section e trascinale per cambiare l'ordine."
      },
      "hold": 600
    },
    {
      "id": "write",
      "title": {
        "en": "Write",
        "it": "Scrivi"
      },
      "scene": "studio-write",
      "camera": {
        "target": "#doc-paper",
        "padding": 12
      },
      "actions": [
        {
          "do": "camera",
          "at": "26%",
          "target": "#doc-tools",
          "padding": 90,
          "duration": 1000,
          "easing": "ease-in-out"
        },
        {
          "do": "move",
          "to": "#doc-tools > button:nth-of-type(4)",
          "at": "30%",
          "duration": 600
        },
        {
          "do": "set",
          "to": "#doc-tools .state",
          "at": "40%",
          "text": "Unsaved changes",
          "add": [
            "dirty"
          ],
          "animate": 200
        },
        {
          "do": "move",
          "to": "#doc-tools > button:nth-of-type(9)",
          "at": "50%",
          "duration": 600
        },
        {
          "do": "move",
          "to": "#doc-tools > button:nth-of-type(15)",
          "at": "70%",
          "duration": 600
        },
        {
          "do": "click",
          "to": "#doc-tools > button:nth-of-type(15)",
          "at": "82%"
        },
        {
          "do": "set",
          "to": "#doc-tools .state",
          "at": "84%",
          "text": "Saved",
          "remove": [
            "dirty"
          ],
          "animate": 200
        }
      ],
      "narration": {
        "en": "Write in the middle, as the reader will see it, with headings, quotes, lists and links from the toolbar. Press Save when you are done.",
        "it": "Scrivi al centro, come lo vedrà chi legge, con titoli, citazioni, elenchi e link dalla barra. Premi Save quando hai finito."
      },
      "hold": 600
    },
    {
      "id": "details",
      "title": {
        "en": "Details",
        "it": "Dettagli"
      },
      "scene": "studio-details",
      "camera": {
        "target": {
          "x": 368,
          "y": 52,
          "width": 760,
          "height": 600
        },
        "padding": 0
      },
      "actions": [
        {
          "do": "move",
          "to": "[data-docpage=details]",
          "at": 0,
          "duration": 0
        },
        {
          "do": "click",
          "to": "[data-docpage=details]",
          "at": "1%"
        },
        {
          "do": "hide",
          "to": ".fieldgrid > label",
          "at": 0,
          "effect": "none",
          "duration": 0,
          "stagger": 0
        },
        {
          "do": "show",
          "to": ".fieldgrid > label",
          "at": "4%",
          "effect": "slide-up",
          "duration": 300,
          "stagger": 70
        },
        {
          "do": "move",
          "to": ".fieldgrid > label:nth-of-type(1) input",
          "at": "32%",
          "duration": 600
        },
        {
          "do": "value",
          "to": ".fieldgrid > label:nth-of-type(1) input",
          "value": "",
          "at": "44%",
          "animate": 200
        },
        {
          "do": "type",
          "to": ".fieldgrid > label:nth-of-type(1) input",
          "text": {
            "en": "How to upload a document",
            "it": "Come caricare un documento"
          },
          "at": "46%",
          "duration": 1100
        },
        {
          "do": "move",
          "to": ".fieldgrid > label:nth-of-type(2) input",
          "at": "72%",
          "duration": 500
        },
        {
          "do": "highlight",
          "to": ".fieldgrid > label:nth-of-type(3)",
          "at": "84%",
          "duration": 900
        }
      ],
      "narration": {
        "en": "Details holds the title, the category and the description shown on the dashboard of the help site.",
        "it": "Details contiene il titolo, la categoria e la descrizione mostrati nella pagina iniziale del sito di aiuto."
      },
      "hold": 600
    },
    {
      "id": "preview",
      "title": {
        "en": "Preview",
        "it": "Anteprima"
      },
      "scene": "studio-doc-preview",
      "camera": {
        "target": {
          "x": 480,
          "y": 90,
          "width": 640,
          "height": 360
        },
        "padding": 0
      },
      "actions": [
        {
          "do": "camera",
          "at": "14%",
          "target": {
            "x": 0,
            "y": 0,
            "width": 1280,
            "height": 720
          },
          "padding": 0,
          "duration": 1500,
          "easing": "ease-in-out"
        },
        {
          "do": "move",
          "to": "#lang",
          "at": "60%",
          "duration": 800
        },
        {
          "do": "highlight",
          "to": "#lang",
          "at": "72%",
          "duration": 1300
        }
      ],
      "narration": {
        "en": "Preview shows the page as it will be published. Each language is its own version of the text.",
        "it": "Preview mostra la pagina come verrà pubblicata. Ogni lingua è una sua versione del testo."
      },
      "hold": 600
    }
  ]
}
