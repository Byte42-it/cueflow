{
  "id": "setup",
  "title": "Set up Cueflow and connect your assistant",
  "scene": "repo-page",
  "vertical": false,
  "format": "video",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "stage": {
    "width": 640,
    "height": 360
  },
  "languages": [
    "en",
    "it"
  ],
  "player": {
    "captions": "below",
    "chapters": true,
    "speeds": [
      1,
      1.5
    ],
    "transcript": true,
    "brand": "stage",
    "fallbackVoice": "none"
  },
  "pronunciation": {},
  "steps": [
    {
      "id": "repo",
      "title": {
        "en": "Get the code",
        "it": "Prendi il codice"
      },
      "scene": "repo-page",
      "camera": {
        "target": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720
        },
        "padding": 0
      },
      "actions": [
        {
          "do": "move",
          "to": "#code-btn",
          "at": "22%",
          "duration": 800
        },
        {
          "do": "click",
          "to": "#code-btn",
          "at": "42%"
        },
        {
          "do": "show",
          "to": "#clone-box",
          "at": "44%",
          "effect": "scale",
          "duration": 280
        },
        {
          "do": "camera",
          "at": "52%",
          "target": "#clone-box",
          "padding": 40,
          "duration": 1000,
          "easing": "ease-in-out"
        },
        {
          "do": "highlight",
          "to": "#clone-url",
          "at": "72%",
          "duration": 1200
        }
      ],
      "narration": {
        "en": "Cueflow is open source. Open its repository on GitHub, press Code, and copy the address.",
        "it": "Cueflow è open source. Apri il suo repository su GitHub, premi Code e copia l'indirizzo."
      },
      "hold": 600
    },
    {
      "id": "clone",
      "title": {
        "en": "Clone it",
        "it": "Clonalo"
      },
      "scene": "terminal",
      "camera": {
        "target": {
          "x": 0,
          "y": 40,
          "width": 1000,
          "height": 562
        },
        "padding": 0
      },
      "actions": [
        {
          "do": "type",
          "to": "#c-clone",
          "text": "git clone https://github.com/Byte42-it/cueflow",
          "at": "8%",
          "duration": 1500
        },
        {
          "do": "show",
          "to": "#o-cloning",
          "at": "42%",
          "effect": "slide-up",
          "duration": 320
        },
        {
          "do": "show",
          "to": "#o-receiving",
          "at": "48%",
          "effect": "slide-up",
          "duration": 320
        },
        {
          "do": "count",
          "to": "#n-recv",
          "at": "50%",
          "from": 0,
          "end": 100,
          "duration": 1000
        },
        {
          "do": "show",
          "to": "#l-cd",
          "at": "76%",
          "effect": "slide-up",
          "duration": 320
        },
        {
          "do": "type",
          "to": "#c-cd",
          "text": "cd cueflow",
          "at": "78%",
          "duration": 500
        }
      ],
      "narration": {
        "en": "In a terminal, run git clone with that address, then move into the new folder.",
        "it": "In un terminale esegui git clone con quell'indirizzo, poi entra nella nuova cartella."
      },
      "hold": 600
    },
    {
      "id": "install",
      "title": {
        "en": "Install",
        "it": "Installa"
      },
      "scene": "terminal",
      "camera": {
        "target": {
          "x": 0,
          "y": 40,
          "width": 1000,
          "height": 562
        },
        "padding": 0
      },
      "actions": [
        {
          "do": "show",
          "to": "#l-install",
          "at": "4%",
          "effect": "slide-up",
          "duration": 320
        },
        {
          "do": "type",
          "to": "#c-install",
          "text": "npm install",
          "at": "8%",
          "duration": 800
        },
        {
          "do": "show",
          "to": "#o-install",
          "at": "42%",
          "effect": "slide-up",
          "duration": 320
        },
        {
          "do": "count",
          "to": "#n-pkg",
          "at": "44%",
          "from": 0,
          "end": 133,
          "duration": 1300
        }
      ],
      "narration": {
        "en": "Install the dependencies with npm install. You need Node 22 or newer.",
        "it": "Installa le dipendenze con npm install. Serve Node 22 o più recente."
      },
      "hold": 600
    },
    {
      "id": "example",
      "title": {
        "en": "See the example",
        "it": "Guarda l'esempio"
      },
      "scene": "terminal",
      "camera": {
        "target": {
          "x": 0,
          "y": 40,
          "width": 1000,
          "height": 562
        },
        "padding": 0
      },
      "actions": [
        {
          "do": "show",
          "to": "#l-studio",
          "at": "4%",
          "effect": "slide-up",
          "duration": 320
        },
        {
          "do": "type",
          "to": "#c-studio",
          "text": "npm run studio",
          "at": "10%",
          "duration": 1000
        },
        {
          "do": "show",
          "to": "#o-studio",
          "at": "52%",
          "effect": "slide-up",
          "duration": 320
        },
        {
          "do": "highlight",
          "to": "#o-studio",
          "at": "58%",
          "duration": 1800
        }
      ],
      "narration": {
        "en": "To see an example, run npm run studio inside the cueflow folder. Studio opens on the tutorials that explain Cueflow itself.",
        "it": "Per vedere un esempio, esegui npm run studio dentro la cartella cueflow. Si apre sui tutorial che spiegano Cueflow."
      },
      "hold": 600
    },
    {
      "id": "own",
      "title": {
        "en": "Use it on your project",
        "it": "Usalo sul tuo progetto"
      },
      "scene": "terminal",
      "camera": {
        "target": {
          "x": 0,
          "y": 40,
          "width": 1000,
          "height": 562
        },
        "padding": 0
      },
      "actions": [
        {
          "do": "show",
          "to": "#l-own",
          "at": "4%",
          "effect": "slide-up",
          "duration": 320
        },
        {
          "do": "type",
          "to": "#c-own",
          "text": "node ../cueflow/src/cli.ts studio",
          "at": "12%",
          "duration": 1800
        },
        {
          "do": "show",
          "to": ".own-out",
          "at": "70%",
          "effect": "slide-up",
          "duration": 300,
          "stagger": 160
        }
      ],
      "narration": {
        "en": "To make tutorials for your own product, run Studio from your project's folder instead, and point to Cueflow's cli. Studio then creates its kit there.",
        "it": "Per i tutorial del tuo prodotto, avvia invece Studio dalla cartella del progetto, indicando il cli di Cueflow. Lì crea il suo kit."
      },
      "hold": 600
    },
    {
      "id": "kit",
      "title": {
        "en": "One folder, one project",
        "it": "Una cartella, un progetto"
      },
      "scene": "studio-welcome",
      "camera": {
        "target": "#where",
        "padding": 120
      },
      "actions": [
        {
          "do": "move",
          "to": "#where",
          "at": "12%",
          "duration": 800
        },
        {
          "do": "highlight",
          "to": "#where",
          "at": "30%",
          "duration": 2200
        },
        {
          "do": "camera",
          "at": "76%",
          "target": {
            "x": 0,
            "y": 0,
            "width": 1280,
            "height": 720
          },
          "padding": 0,
          "duration": 1100,
          "easing": "ease-in-out"
        }
      ],
      "narration": {
        "en": "Cueflow keeps your tutorials as data, in a folder called .cueflow inside your project. Studio creates it the first time.",
        "it": "Cueflow conserva i tutorial come dati, in una cartella chiamata .cueflow dentro il tuo progetto. Studio la crea la prima volta."
      },
      "speech": {
        "en": "Cueflow keeps your tutorials as data, in a folder called dot cueflow inside your project. Studio creates it the first time.",
        "it": "Cueflow conserva i tutorial come dati, in una cartella chiamata punto cueflow dentro il tuo progetto. Studio la crea la prima volta."
      },
      "hold": 600
    },
    {
      "id": "studio",
      "title": {
        "en": "Open Studio",
        "it": "Apri Studio"
      },
      "scene": "studio-welcome",
      "camera": {
        "target": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720
        },
        "padding": 0
      },
      "actions": [
        {
          "do": "hide",
          "to": ".wbox > *",
          "at": 0,
          "effect": "none",
          "duration": 0,
          "stagger": 0
        },
        {
          "do": "show",
          "to": ".wbox > *",
          "at": "4%",
          "effect": "slide-up",
          "duration": 340,
          "stagger": 110
        },
        {
          "do": "camera",
          "at": "58%",
          "target": "#welcome-prompt",
          "padding": 70,
          "duration": 1000,
          "easing": "ease-in-out"
        },
        {
          "do": "highlight",
          "to": "#welcome-prompt",
          "at": "72%",
          "duration": 1400
        }
      ],
      "narration": {
        "en": "Studio opens in the browser and finds the kit by itself. The kit is empty, so it offers a prompt for your assistant.",
        "it": "Studio si apre nel browser e trova il kit da solo. Il kit è vuoto, quindi propone un prompt per il tuo assistente."
      },
      "hold": 600
    },
    {
      "id": "copy",
      "title": {
        "en": "Copy the prompt",
        "it": "Copia il prompt"
      },
      "scene": "studio-welcome",
      "camera": {
        "target": "#welcome-copy",
        "padding": 130
      },
      "actions": [
        {
          "do": "move",
          "to": "#welcome-copy",
          "at": "8%",
          "duration": 800
        },
        {
          "do": "click",
          "to": "#welcome-copy",
          "at": "26%"
        },
        {
          "do": "set",
          "to": "#welcome-copy",
          "at": "28%",
          "text": "Copied",
          "animate": 200
        },
        {
          "do": "highlight",
          "to": "#welcome-copy",
          "at": "30%",
          "duration": 1300
        }
      ],
      "narration": {
        "en": "Press Copy the prompt, open your assistant in the project's folder, and paste it. Claude Code works well, and so does any assistant that can run curl or use MCP.",
        "it": "Premi Copy the prompt, apri il tuo assistente nella cartella del progetto e incollalo. Va bene Claude Code, ma anche ogni assistente che sa eseguire curl o usare MCP."
      },
      "hold": 600
    },
    {
      "id": "door",
      "title": {
        "en": "Studio's own door",
        "it": "La porta di Studio"
      },
      "scene": "studio-ai",
      "camera": {
        "target": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720
        },
        "padding": 0
      },
      "actions": [
        {
          "do": "move",
          "to": "#ai",
          "at": "6%",
          "duration": 800
        },
        {
          "do": "click",
          "to": "#ai",
          "at": "20%"
        },
        {
          "do": "show",
          "to": "#dlg",
          "at": "22%",
          "effect": "scale",
          "duration": 320
        },
        {
          "do": "camera",
          "at": "30%",
          "target": "#dlg",
          "padding": 24,
          "duration": 1000,
          "easing": "ease-in-out"
        },
        {
          "do": "highlight",
          "to": "#dlg pre.prompt",
          "at": "48%",
          "duration": 2200
        }
      ],
      "narration": {
        "en": "The prompt gives the assistant Studio's own door: a few curl commands that work while Studio runs, on this computer only. You can also add Cueflow as an MCP server.",
        "it": "Il prompt dà all'assistente la porta di Studio: pochi comandi curl che funzionano finché Studio è aperto, solo su questo computer. Puoi anche aggiungere Cueflow come server MCP."
      },
      "hold": 600
    },
    {
      "id": "connected",
      "title": {
        "en": "Talk to it from Studio",
        "it": "Parlagli da Studio"
      },
      "scene": "studio-timeline",
      "camera": {
        "target": "#film",
        "padding": 30
      },
      "actions": [
        {
          "do": "hide",
          "to": "#film .tilewrap",
          "at": 0,
          "effect": "none",
          "duration": 0,
          "stagger": 0
        },
        {
          "do": "show",
          "to": "#film .tilewrap",
          "at": "42%",
          "effect": "slide-up",
          "duration": 380,
          "stagger": 180
        },
        {
          "do": "move",
          "to": "#film .tilewrap:nth-of-type(3)",
          "at": "58%",
          "duration": 800
        },
        {
          "do": "camera",
          "at": "80%",
          "target": {
            "x": 0,
            "y": 0,
            "width": 1280,
            "height": 720
          },
          "padding": 0,
          "duration": 1000,
          "easing": "ease-in-out"
        }
      ],
      "narration": {
        "en": "Once connected, what you ask in Studio goes straight to the assistant, and the tutorials it makes appear here by themselves.",
        "it": "Una volta collegato, quello che chiedi in Studio arriva direttamente all'assistente, e i tutorial che crea compaiono qui da soli."
      },
      "hold": 600
    }
  ]
}
